__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/

# Machine-local environment overlays (`personal.local.toml` and friends). The paths and
# in-house tooling they name are true of one workstation and false of every other, so a
# committed overlay would break the next machine that pulled it. The engine layers them
# over the committed profile when present and says so when they are absent.
environments/*.local.toml

# Machine-local TOOL entries: in-house tooling whose NAME must not travel. The engine
# loads them tagged `_local` and drops them before writing any tracked artefact, so
# ignoring the directory cannot be defeated by rendering the README.
tools.local/

# The home directories of OTHER machines, declared so the redaction can map them out of
# reports synced in from those machines. An account name is exactly what the redaction
# exists to withhold, so the declaration cannot be tracked: committing it would publish
# the name in order to say the name must not be published.
redact.local.toml

# A Windows reserved device name. A tool handed `--output /dev/null` from a POSIX shell on
# Windows creates a FILE called `nul` here, after which git fails on every add with an
# error that names mmap rather than the file.
nul
