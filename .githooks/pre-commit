#!/bin/sh
# The pre-commit hook, installed with `git config core.hooksPath .githooks`.
#
# Why not `pre-commit install`? That writes a hook which invokes the `pre-commit` console
# script directly, and a machine whose policy blocks unsigned shims leaves `.git/hooks/`
# looking armed while nothing runs - worse than no hook, because the absence is silent.
# Invoking the module through `uv run` works there and pins the project's own interpreter.
#
# Tracked, so a fresh clone arms the lane with one command rather than a recipe. Skip a
# run with `git commit --no-verify` when you mean to; CI runs the full set regardless.
HERE=$(dirname "$0")
exec uv run python -m pre_commit hook-impl \
	--config=.pre-commit-config.yaml \
	--hook-type=pre-commit \
	--hook-dir "$HERE" \
	-- "$@"
